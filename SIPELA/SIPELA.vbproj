<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <StartupObject>Sub Main</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
    <MyType>WindowsForms</MyType>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="My Project\Application.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Application.myapp</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="My Project\Application.myapp">
      <Generator>MyApplicationCodeGenerator</Generator>
      <LastGenOutput>Application.Designer.vb</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MySql.Data" Version="26.10.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\Icons\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Forms\frmLogin.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\frmLogin.Designer.vb">
      <DependentUpon>frmLogin.vb</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Forms\frmLogin.resx">
      <DependentUpon>frmLogin.vb</DependentUpon>
    </EmbeddedResource>

    <Compile Update="Forms\frmMasterLapangan.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\frmMasterLapangan.Designer.vb">
      <DependentUpon>frmMasterLapangan.vb</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Forms\frmMasterLapangan.resx">
      <DependentUpon>frmMasterLapangan.vb</DependentUpon>
    </EmbeddedResource>

    <Compile Update="Forms\frmMasterUsers.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\frmMasterUsers.Designer.vb">
      <DependentUpon>frmMasterUsers.vb</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Forms\frmMasterUsers.resx">
      <DependentUpon>frmMasterUsers.vb</DependentUpon>
    </EmbeddedResource>

    <Compile Update="Forms\frmMenuUtama.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\frmMenuUtama.Designer.vb">
      <DependentUpon>frmMenuUtama.vb</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Forms\frmMenuUtama.resx">
      <DependentUpon>frmMenuUtama.vb</DependentUpon>
    </EmbeddedResource>

    <Compile Update="Forms\frmPemesanan.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\frmPemesanan.Designer.vb">
      <DependentUpon>frmPemesanan.vb</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Forms\frmPemesanan.resx">
      <DependentUpon>frmPemesanan.vb</DependentUpon>
    </EmbeddedResource>

    <Compile Update="Forms\frmLaporan.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\frmLaporan.Designer.vb">
      <DependentUpon>frmLaporan.vb</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Forms\frmLaporan.resx">
      <DependentUpon>frmLaporan.vb</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

</Project>